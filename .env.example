# ============================================================
# JobRadar — Environment Variables Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# --- State storage path (default: data/job_state.json) ---
STATE_FILE_PATH=data/job_state.json

# --- Gmail API (Google Cloud Console OAuth 2.0) ---
NOTIFICATION_EMAIL=your-email@gmail.com
GMAIL_CREDENTIALS_JSON={"installed":{"client_id":"...","client_secret":"...","redirect_uris":["http://localhost"]}}
GMAIL_TOKEN_JSON={"token":"...","refresh_token":"...","token_uri":"https://oauth2.googleapis.com/token","client_id":"...","client_secret":"...","scopes":["https://www.googleapis.com/auth/gmail.send"]}

# --- Collector thresholds ---
MAX_POSTING_AGE_HOURS=24
MIN_MATCH_SCORE=40
NOTIFICATION_MIN_SCORE=50
MAX_JOBS_PER_SOURCE=100
REQUEST_TIMEOUT=30
REQUEST_DELAY_SECONDS=2

# --- Optional: Telegram bot (alternative fallback) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
