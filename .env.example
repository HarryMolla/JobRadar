# ============================================================
# JobRadar — Environment Variables Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# --- Supabase (Free tier at supabase.com) ---
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# --- Gmail API (Google Cloud Console) ---
GMAIL_CREDENTIALS_JSON={"installed":{"client_id":"...","client_secret":"...","redirect_uris":["urn:ietf:wg:oauth:2.0:oob","http://localhost"]}}
GMAIL_TOKEN_JSON={"token":"...","refresh_token":"...","token_uri":"...","client_id":"...","client_secret":"...","scopes":["https://www.googleapis.com/auth/gmail.send"]}
NOTIFICATION_EMAIL=your-email@gmail.com

# --- Collector settings ---
MIN_MATCH_SCORE=40
NOTIFICATION_MIN_SCORE=50
MAX_JOBS_PER_SOURCE=100
REQUEST_TIMEOUT=30
REQUEST_DELAY_SECONDS=2

# --- Optional: Telegram bot (alternative notification) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
