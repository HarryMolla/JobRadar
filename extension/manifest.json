{
  "manifest_version": 3,
  "name": "JobRadar",
  "version": "1.0.0",
  "description": "Automated job monitor for UI/UX designers and frontend developers. Finds remote and sponsored roles that accept applicants from Ethiopia.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    },
    "default_title": "JobRadar"
  },
  "options_page": "options/options.html",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "notifications",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "http://127.0.0.1:8765/*",
    "https://*.supabase.co/*"
  ]
}

